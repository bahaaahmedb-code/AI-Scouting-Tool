{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "framework": null,
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{artifacts/**,backend/app/**,backend/config.yaml}",
      "excludeFiles": "{frontend/**,data/**,backend/data/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
